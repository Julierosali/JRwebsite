# À copier en .env.local (ne jamais commiter .env.local)

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xnldksrwfsfxgemzkfrs.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
# Clé secrète : uniquement côté serveur (API statistiques). Ne jamais l'exposer dans du code client.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Adresse publique du site, sans slash final (canonical, sitemap, JSON-LD, Open Graph).
# Sur Vercel, si absente, le domaine de production Vercel est utilisé.
NEXT_PUBLIC_SITE_URL=https://www.exemple.fr

# Sel pour hasher les IP (statistiques). À changer une fois pour toutes.
ANALYTICS_IP_SALT=change-me

# Secret de la tâche planifiée Vercel qui supprime les statistiques de plus de 3 mois.
CRON_SECRET=une-longue-chaine-aleatoire
